{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khaemenes://schemas/response-package-v1",
  "title": "Khaemenes Assessment Response Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "assessmentVersion", "courseCode", "learner", "submittedAt", "responses"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "assessmentId": {"type": "string", "minLength": 8},
    "assessmentVersion": {"type": "string", "minLength": 1},
    "courseCode": {"type": "string", "minLength": 2},
    "learner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learnerId"],
      "properties": {
        "learnerId": {"type": "string", "minLength": 1},
        "displayName": {"type": ["string", "null"]}
      }
    },
    "submittedAt": {"type": "string", "format": "date-time"},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "response"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "response": {}
        }
      }
    },
    "clientIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    }
  }
}
