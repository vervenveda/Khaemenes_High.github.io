{
  "unit": 12,
  "title": "Probability, Distributions & Statistical Inference",
  "terms": [
    {
      "en": "fundamental counting principle",
      "es": "principio fundamental del conteo",
      "fr": "principe fondamental de dénombrement",
      "ar": "مبدأ العد الأساسي",
      "pt": "princípio fundamental da contagem",
      "definition": "If one stage has m outcomes and another n, their combined ordered choices number mn."
    },
    {
      "en": "permutation",
      "es": "permutación",
      "fr": "permutation",
      "ar": "تبديل",
      "pt": "permutação",
      "definition": "An ordered arrangement of selected objects."
    },
    {
      "en": "combination",
      "es": "combinación",
      "fr": "combinaison",
      "ar": "توافيق",
      "pt": "combinação",
      "definition": "A selection of objects where order does not matter."
    },
    {
      "en": "probability",
      "es": "probabilidad",
      "fr": "probabilité",
      "ar": "احتمال",
      "pt": "probabilidade",
      "definition": "A numerical measure between 0 and 1 of the likelihood of an event."
    },
    {
      "en": "addition rule",
      "es": "regla de adición",
      "fr": "règle d'addition",
      "ar": "قاعدة الجمع للاحتمالات",
      "pt": "regra da adição",
      "definition": "P(A or B)=P(A)+P(B)-P(A and B)."
    },
    {
      "en": "complement rule",
      "es": "regla del complemento",
      "fr": "règle du complément",
      "ar": "قاعدة المتمم",
      "pt": "regra do complemento",
      "definition": "P(not A)=1-P(A)."
    },
    {
      "en": "conditional probability",
      "es": "probabilidad condicional",
      "fr": "probabilité conditionnelle",
      "ar": "احتمال شرطي",
      "pt": "probabilidade condicional",
      "definition": "P(A given B)=P(A and B)/P(B) when P(B)>0."
    },
    {
      "en": "independence",
      "es": "independencia",
      "fr": "indépendance",
      "ar": "استقلال الأحداث",
      "pt": "independência",
      "definition": "Events A and B are independent when P(A and B)=P(A)P(B)."
    },
    {
      "en": "binomial distribution",
      "es": "distribución binomial",
      "fr": "loi binomiale",
      "ar": "توزيع ثنائي الحدين",
      "pt": "distribuição binomial",
      "definition": "A distribution counting successes across independent Bernoulli trials with fixed success probability."
    },
    {
      "en": "Bernoulli trial",
      "es": "ensayo de Bernoulli",
      "fr": "épreuve de Bernoulli",
      "ar": "تجربة برنولي",
      "pt": "ensaio de Bernoulli",
      "definition": "A trial with success and failure outcomes."
    },
    {
      "en": "expected value",
      "es": "valor esperado",
      "fr": "espérance mathématique",
      "ar": "القيمة المتوقعة",
      "pt": "valor esperado",
      "definition": "The probability-weighted mean of a random variable."
    },
    {
      "en": "normal distribution",
      "es": "distribución normal",
      "fr": "loi normale",
      "ar": "التوزيع الطبيعي",
      "pt": "distribuição normal",
      "definition": "A symmetric bell-shaped continuous probability distribution specified by mean and standard deviation."
    },
    {
      "en": "standard deviation",
      "es": "desviación estándar",
      "fr": "écart-type",
      "ar": "الانحراف المعياري",
      "pt": "desvio padrão",
      "definition": "A measure of data or distribution spread around its mean."
    },
    {
      "en": "z-score",
      "es": "puntuación z",
      "fr": "cote z",
      "ar": "درجة معيارية",
      "pt": "escore z",
      "definition": "The number of standard deviations a value lies above or below a mean."
    },
    {
      "en": "random sampling",
      "es": "muestreo aleatorio",
      "fr": "échantillonnage aléatoire",
      "ar": "أخذ عينات عشوائية",
      "pt": "amostragem aleatória",
      "definition": "A sampling procedure where selection probabilities are specified."
    },
    {
      "en": "sampling bias",
      "es": "sesgo de muestreo",
      "fr": "biais d'échantillonnage",
      "ar": "انحياز العينة",
      "pt": "viés de amostragem",
      "definition": "Systematic selection effects that distort representation of the target population."
    },
    {
      "en": "margin of error",
      "es": "margen de error",
      "fr": "marge d'erreur",
      "ar": "هامش الخطأ",
      "pt": "margem de erro",
      "definition": "A stated bound on estimation error under a given method and confidence level."
    },
    {
      "en": "confidence interval",
      "es": "intervalo de confianza",
      "fr": "intervalle de confiance",
      "ar": "فترة الثقة",
      "pt": "intervalo de confiança",
      "definition": "An interval procedure designed to contain a fixed population parameter in a specified fraction of repeated samples."
    },
    {
      "en": "statistical inference",
      "es": "inferencia estadística",
      "fr": "inférence statistique",
      "ar": "استدلال إحصائي",
      "pt": "inferência estatística",
      "definition": "Drawing population conclusions using sample evidence and uncertainty."
    },
    {
      "en": "statistical claim",
      "es": "afirmación estadística",
      "fr": "affirmation statistique",
      "ar": "ادعاء إحصائي",
      "pt": "afirmação estatística",
      "definition": "A statement about data or a population requiring evidence and an uncertainty check."
    }
  ],
  "schema_version": "1.1"
}
