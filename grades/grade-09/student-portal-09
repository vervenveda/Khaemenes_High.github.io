<body>
<a class="skip" href="#workspace">Skip to profile workspace</a>
<header class="top">
  <div class="shell nav">
    <a class="brand" href="../../"><span class="mark">K</span><span><strong>Khaemenes Academy</strong><small id="brandSub">Grade Student Portal</small></span></a>
    <nav class="navlinks" aria-label="Student portal navigation">
      <a href="../../">School Home</a>
      <a href="../../courses/">Courses</a>
      <a href="/Khaemenes_Academy.github.io/student/">Academy Student</a>
      <a href="/Khaemenes_Academy.github.io/family/">Family Hub</a>
      <button type="button" id="privacyBtn">Privacy Mode</button>
    </nav>
  </div>
  <div class="shell hero">
    <p class="eyebrow" id="eyebrow">Khaemenes Academy · Grade Directory</p>
    <h1 id="heroTitle">Student Portal</h1>
    <p id="heroLead">A grade-level dashboard for the active learner, course doors, goals, journal notes, portfolio links, exports, and printable records.</p>
    <div class="hero-actions">
      <a class="btn gold" id="continueBtn" href="#classes">Continue Classes</a>
      <a class="btn secondary" href="/Khaemenes_Academy.github.io/family/enroll/">Review Placement</a>
      <button class="btn secondary" type="button" id="printBtn">Print Summary</button>
    </div>
  </div>
</header>

<main class="section" id="workspace">
  <div class="shell grid">
    <section class="card col3 profile" id="profileCard">
      <div class="avatar-wrap"><div class="avatar" id="avatar">K</div></div>
      <input class="hidden-file" type="file" id="avatarInput" accept="image/*">
      <button class="btn secondary hide-private" type="button" id="avatarBtn">Change Avatar</button>
      <div class="profile-name private-field" id="profileName">Learner</div>
      <div class="subline" id="placementLine">Placement loading…</div>
      <div class="chips"><span class="chip" id="studentIdChip">Student ID pending</span><span class="chip" id="gradeChip">Grade</span></div>
      <div class="progress" aria-label="Overall profile progress"><span id="overallBar"></span></div>
      <div class="metrics"><div class="metric"><strong id="metricCourses">0</strong><span>Courses</span></div><div class="metric"><strong id="metricAvg">0%</strong><span>Average</span></div><div class="metric"><strong id="metricGoals">0</strong><span>Goals</span></div></div>
      <div class="badge-row" id="badges"></div>
    </section>

    <section class="card col5" id="editCard">
      <p class="eyebrow" style="color:var(--burgundy)">Editable Profile</p>
      <h2>Student profile</h2>
      <p>These fields save locally in this browser for the active learner and grade directory. Keep private details out of public screenshots and exports unless a family chooses otherwise.</p>
      <div class="two"><div class="field"><label>Display name / nickname</label><input id="nameInput" maxlength="40" placeholder="Learner"></div><div class="field"><label>Preferred study rhythm</label><select id="rhythmInput"><option>Steady daily practice</option><option>Deep work blocks</option><option>Short focused sessions</option><option>Project-based work</option><option>Teacher-guided pacing</option></select></div></div>
      <div class="field"><label>Interests</label><input id="interestsInput" maxlength="220" placeholder="Separate interests with commas"></div>
      <div class="field"><label>Current goals</label><textarea id="goalsInput" placeholder="What should this learner focus on this week?"></textarea></div>
      <div class="field"><label>Support notes</label><textarea id="supportInput" placeholder="What helps this learner succeed? Keep sensitive details private."></textarea></div>
      <div class="tools"><button class="btn" type="button" id="saveProfileBtn">Save Profile</button><button class="btn secondary" type="button" id="exportBtn">Export JSON</button><label class="btn secondary" for="importInput">Import JSON</label><input class="hidden-file" type="file" id="importInput" accept="application/json,.json"><button class="btn warn" type="button" id="resetBtn">Reset Local Grade Profile</button></div>
    </section>

    <section class="card col4">
      <p class="eyebrow" style="color:var(--burgundy)">Quick Plan</p>
      <h2>Today’s focus</h2>
      <div class="notice good" id="readyNotice">Profile workspace ready.</div>
      <div class="list" id="goalList"></div>
      <div class="field"><label>Add a focus item</label><input id="goalItemInput" placeholder="Example: Finish Week 03 math lesson"></div>
      <div class="tools"><button class="btn" type="button" id="addGoalBtn">Add Focus</button><button class="btn secondary" type="button" id="clearGoalsBtn">Clear Done</button></div>
    </section>

    <section class="card col8" id="classes">
      <p class="eyebrow" style="color:var(--burgundy)">Grade Directory</p>
      <h2 id="classesTitle">My classes</h2>
      <p id="classesLead">Grade-level courses appear here. Adjust progress locally or open the course doorway.</p>
      <div class="class-grid" id="classGrid"></div>
    </section>

    <section class="card col4">
      <p class="eyebrow" style="color:var(--burgundy)">Portfolio</p>
      <h2>Saved links</h2>
      <p>Keep local shortcuts to essays, projects, artwork, labs, certificates, or class resources.</p>
      <div class="two"><div class="field"><label>Title</label><input id="portfolioTitle" placeholder="Project title"></div><div class="field"><label>URL or note</label><input id="portfolioUrl" placeholder="https://… or local note"></div></div>
      <div class="tools"><button class="btn" type="button" id="addPortfolioBtn">Add Link</button></div>
      <div class="list" id="portfolioList"></div>
    </section>

    <section class="card col7">
      <p class="eyebrow" style="color:var(--burgundy)">Learning Journal</p>
      <h2>Notes and reflections</h2>
      <div class="journal" id="journal"></div>
      <div id="journalComposer"><div class="field"><label>New journal note</label><textarea id="journalInput" placeholder="Write a reflection, mentor note, question, or parent/teacher conference note."></textarea></div><div class="tools"><button class="btn" type="button" id="addJournalBtn">Add Journal Note</button><button class="btn secondary" type="button" id="clearJournalBtn">Clear Journal</button></div></div>
    </section>

    <section class="card col5">
      <p class="eyebrow" style="color:var(--burgundy)">Records</p>
      <h2>Local-only boundary</h2>
      <p>This grade portal is a browser-local helper. It does not authenticate students, award official credit, or send private information to a server. Course engines remain responsible for course mastery evidence.</p>
      <div class="notice">Use the Academy Family Hub for family records, learner switching, placement, and backups. Use course dashboards for scores and mastery.</div>
      <div class="tools"><a class="btn secondary" href="/Khaemenes_Academy.github.io/student/">Academy Student Portal</a><a class="btn secondary" href="/Khaemenes_Academy.github.io/family/">Family Hub</a><button class="btn secondary" type="button" id="safeBtn">Safe Mode</button></div>
      <pre class="safe" id="safeBox"></pre>
    </section>
  </div>
</main>

<footer class="footer"><strong>Khaemenes Academy</strong><span>Jennifer Kay Pearl · Verve N Veda · Grade Student Portal Template</span></footer>

