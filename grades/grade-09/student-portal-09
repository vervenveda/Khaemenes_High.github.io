function normalizeGrade(value){
  const raw=String(value??"").trim().toLowerCase().replace(/grade|gr\.?/g,"").replace(/_/g,"-");
  if(["pre-k","prek","pk","preschool"].includes(raw))return "pre-k";
  if(["k","kg","kindergarten","kinder"].includes(raw))return "k";
  const n=Number(raw.replace(/[^0-9]/g,""));
  if(Number.isInteger(n)&&n>=1&&n<=12)return String(n).padStart(2,"0");
  return null;
}
const grade=detectGrade();
const meta=GRADE_META[grade]||GRADE_META["09"];
const subjects=SUBJECTS[meta.stage]||SUBJECTS.high;
const state={grade,meta,learner:null,profile:null,privacy:false};
function learnerId(){return state.learner?.learnerId||`local-${grade}`}
function key(){return `khaemenes_grade_profile_v2:${learnerId()}:${grade}`}
function defaultProfile(){return {version:2,grade,createdAt:now(),updatedAt:now(),displayName:state.learner?.nickname||"Learner",rhythm:"Steady daily practice",interests:(state.learner?.interests||[]).join(", "),goals:"",support:"",avatar:null,focus:[],portfolio:[],journal:[],progress:{}}}
function loadProfile(){try{return {...defaultProfile(),...(JSON.parse(localStorage.getItem(key())||"null")||{})}}catch{return defaultProfile()}}
function saveProfile(){state.profile.updatedAt=now();localStorage.setItem(key(),JSON.stringify(state.profile));}
function setupIdentity(){
  const R=window.KhaemenesFamilyRegistry, IDs=window.KhaemenesInstitutionalId;
  state.learner=R?.getLearner?.()||null;
  try{IDs?.ensureAll?.()}catch{}
  state.profile=loadProfile();
}
function applyMeta(){
  document.title=`Khaemenes Academy · ${meta.label} Student Portal`;
  $("#brandSub").textContent=`${meta.label} · Student Portal`;
  $("#eyebrow").textContent=`${meta.school} · ${meta.label}`;
  $("#heroTitle").textContent=meta.title;
  $("#heroLead").textContent=meta.lead;
  $("#classesTitle").textContent=`${meta.label} classes`;
  $("#classesLead").textContent=`These ${meta.label} course doors can be copied into the matching grade directory and adjusted as that grade's curriculum grows.`;
}
function render(){
  setupIdentity(); applyMeta();
  const p=state.profile;
  $("#profileName").textContent=p.displayName||state.learner?.nickname||"Learner";
  $("#placementLine").textContent=`${meta.label} · ${meta.school}`;
  $("#gradeChip").textContent=meta.label;
  const idInfo=(()=>{try{return window.KhaemenesInstitutionalId?.get?.(state.learner)||null}catch{return null}})();
  $("#studentIdChip").textContent=idInfo?`${idInfo.identifierType==="scholar"?"Scholar ID":"Student ID"}: ${idInfo.institutionalId}`:"Student ID pending";
  renderAvatar(); fillInputs(); renderClasses(); renderFocus(); renderPortfolio(); renderJournal(); renderBadges(); updateMetrics(); updateSafe();
}
function renderAvatar(){
  const a=$("#avatar"), p=state.profile;
  if(p.avatar){a.innerHTML=`<img alt="Local profile avatar" src="${esc(p.avatar)}">`}
  else{const name=p.displayName||state.learner?.nickname||"K";a.textContent=name.trim().slice(0,1).toUpperCase()||"K"}
}
function fillInputs(){
  const p=state.profile;
  $("#nameInput").value=p.displayName||"";$("#rhythmInput").value=p.rhythm||"Steady daily practice";$("#interestsInput").value=p.interests||"";$("#goalsInput").value=p.goals||"";$("#supportInput").value=p.support||"";
}
function renderClasses(){
  const grid=$("#classGrid"), p=state.profile;
  grid.innerHTML=subjects.map(([title,desc,href,color],i)=>{
    const id=title.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
    const pct=clamp(p.progress[id]??0,0,100);
    const url=href+(href.includes("?")?"&":"?")+`grade=${encodeURIComponent(grade)}`;
    return `<article class="class-card" style="--accent:${color}"><strong>${esc(title)}</strong><small>${esc(meta.label)} pathway</small><p>${esc(desc)}</p><div class="slider-row"><input type="range" min="0" max="100" value="${pct}" data-progress="${esc(id)}" aria-label="${esc(title)} progress"><span class="pct">${pct}%</span></div><a class="btn secondary" href="${esc(url)}">Open ${esc(title)}</a></article>`;
  }).join("");
  $$('[data-progress]').forEach(input=>input.addEventListener('input',()=>{state.profile.progress[input.dataset.progress]=clamp(input.value,0,100);input.nextElementSibling.textContent=`${state.profile.progress[input.dataset.progress]}%`;saveProfile();updateMetrics();renderBadges();}));
}
function averageProgress(){const vals=subjects.map(([title])=>clamp(state.profile.progress[title.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")]||0,0,100));return Math.round(vals.reduce((a,b)=>a+b,0)/(vals.length||1));}
function updateMetrics(){
  const avg=averageProgress(); const goals=(state.profile.focus||[]).filter(x=>!x.done).length;
  $("#metricCourses").textContent=subjects.length;$("#metricAvg").textContent=`${avg}%`;$("#metricGoals").textContent=goals;$("#overallBar").style.width=`${avg}%`;
  $("#readyNotice").className=avg>=80?"notice good":"notice";$("#readyNotice").textContent=avg>=80?"Strong progress signal. Continue collecting mastery evidence in the course dashboards.":"Use today's focus list and course doors to keep the week organized.";
}
function renderBadges(){
  const avg=averageProgress(), journal=(state.profile.journal||[]).length, portfolio=(state.profile.portfolio||[]).length;
  const badges=[['✦','Profile Started',true],['📚','Course Explorer',avg>=20],['📝','Journal Builder',journal>=3],['◇','Portfolio Keeper',portfolio>=2],['🏛','Mastery Focus',avg>=80]];
  $("#badges").innerHTML=badges.map(([icon,label,on])=>`<span class="badge ${on?'':'locked'}" title="${esc(label)}">${icon} ${esc(label)}</span>`).join("");
}
function renderFocus(){
  const list=$("#goalList"), items=state.profile.focus||[];
  list.innerHTML=items.length?items.map((g,i)=>`<div class="row"><span><strong class="${g.done?'hide-private':''}">${esc(g.text)}</strong><small>${g.done?'Done':'Active focus'} · ${esc((g.at||'').slice(0,10))}</small></span><button class="btn secondary" type="button" data-goal="${i}">${g.done?'Undo':'Done'}</button></div>`).join(""):'<div class="notice">No focus items yet. Add one clear next step for today.</div>';
  $$('[data-goal]').forEach(b=>b.onclick=()=>{const i=Number(b.dataset.goal);state.profile.focus[i].done=!state.profile.focus[i].done;saveProfile();renderFocus();updateMetrics();});
}
function renderPortfolio(){
  const list=$("#portfolioList"), items=state.profile.portfolio||[];
  list.innerHTML=items.length?items.map((x,i)=>{const isUrl=/^https?:\/\//i.test(x.url||"");return `<div class="row"><span><strong>${esc(x.title)}</strong><small>${esc(x.url||"Local note")}</small></span>${isUrl?`<a class="btn secondary" href="${esc(x.url)}" rel="noopener">Open</a>`:`<button class="btn secondary" data-del-portfolio="${i}" type="button">Remove</button>`}</div>`}).join(""):'<div class="notice">No portfolio links yet.</div>';
  $$('[data-del-portfolio]').forEach(b=>b.onclick=()=>{state.profile.portfolio.splice(Number(b.dataset.delPortfolio),1);saveProfile();renderPortfolio();renderBadges();});
}
function renderJournal(){
  const box=$("#journal"), items=state.profile.journal||[];
  box.innerHTML=items.length?items.slice().reverse().map(e=>`<div class="entry"><small>${esc((e.at||'').replace('T',' ').slice(0,16))}</small><div>${esc(e.text)}</div></div>`).join(""):'<div class="notice">No journal notes yet. This space is for reflections, mentor notes, parent notes, and questions.</div>';
}
function updateSafe(){
  const out={grade,meta,learnerId:learnerId(),storageKey:key(),hasAcademyRegistry:Boolean(window.KhaemenesFamilyRegistry),hasLearner:Boolean(state.learner),profileVersion:state.profile?.version,origin:location.origin,path:location.pathname,localOnly:true};
  $("#safeBox").textContent=JSON.stringify(out,null,2);
}
function resizeImage(file){
  return new Promise((resolve,reject)=>{
    if(!file||!file.type.startsWith('image/'))return reject(new Error('image-required'));
    const reader=new FileReader();reader.onerror=()=>reject(new Error('read-failed'));reader.onload=()=>{
      const img=new Image();img.onload=()=>{const size=320,canvas=document.createElement('canvas'),ctx=canvas.getContext('2d');canvas.width=size;canvas.height=size;const scale=Math.max(size/img.width,size/img.height),w=img.width*scale,h=img.height*scale,x=(size-w)/2,y=(size-h)/2;ctx.drawImage(img,x,y,w,h);resolve(canvas.toDataURL('image/jpeg',0.82));};img.onerror=()=>reject(new Error('image-load-failed'));img.src=reader.result;};reader.readAsDataURL(file);
  });
}
function bind(){
  $("#privacyBtn").onclick=()=>{state.privacy=!state.privacy;document.body.classList.toggle('privacy',state.privacy);$("#privacyBtn").textContent=state.privacy?'Show Private':'Privacy Mode';};
  $("#printBtn").onclick=()=>print();
  $("#saveProfileBtn").onclick=()=>{state.profile.displayName=$("#nameInput").value.trim()||"Learner";state.profile.rhythm=$("#rhythmInput").value;state.profile.interests=$("#interestsInput").value.trim();state.profile.goals=$("#goalsInput").value.trim();state.profile.support=$("#supportInput").value.trim();saveProfile();render();};
  $("#addGoalBtn").onclick=()=>{const v=$("#goalItemInput").value.trim();if(!v)return;state.profile.focus=[...(state.profile.focus||[]),{text:v,done:false,at:now()}].slice(-40);$("#goalItemInput").value='';saveProfile();renderFocus();updateMetrics();};
  $("#clearGoalsBtn").onclick=()=>{state.profile.focus=(state.profile.focus||[]).filter(x=>!x.done);saveProfile();renderFocus();updateMetrics();};
  $("#addPortfolioBtn").onclick=()=>{const title=$("#portfolioTitle").value.trim(),url=$("#portfolioUrl").value.trim();if(!title)return;state.profile.portfolio=[...(state.profile.portfolio||[]),{title,url,at:now()}].slice(-40);$("#portfolioTitle").value='';$("#portfolioUrl").value='';saveProfile();renderPortfolio();renderBadges();};
  $("#addJournalBtn").onclick=()=>{const text=$("#journalInput").value.trim();if(!text)return;state.profile.journal=[...(state.profile.journal||[]),{text,at:now()}].slice(-120);$("#journalInput").value='';saveProfile();renderJournal();renderBadges();};
  $("#clearJournalBtn").onclick=()=>{if(confirm('Clear the local journal for this grade profile?')){state.profile.journal=[];saveProfile();renderJournal();renderBadges();}};
  $("#avatarBtn").onclick=()=>$("#avatarInput").click();
  $("#avatarInput").onchange=async e=>{try{const data=await resizeImage(e.target.files[0]);state.profile.avatar=data;saveProfile();renderAvatar();}catch(err){alert('Could not use that image. Please choose a standard image file.')}};
  $("#exportBtn").onclick=()=>{const data={format:'khaemenes-grade-profile-export-v2',exportedAt:now(),grade,meta,learnerId:learnerId(),profile:state.profile};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=`khaemenes-${grade}-student-profile.json`;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};
  $("#importInput").onchange=e=>{const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const data=JSON.parse(reader.result);if(!data.profile)throw new Error('missing-profile');state.profile={...defaultProfile(),...data.profile,grade};saveProfile();render();}catch{alert('That JSON file does not look like a Khaemenes grade profile export.')}};reader.readAsText(file);};
  $("#resetBtn").onclick=()=>{if(confirm('Reset this local grade profile only? Academy family records will not be erased.')){localStorage.removeItem(key());render();}};
  $("#safeBtn").onclick=()=>{$("#safeBox").classList.toggle('on');updateSafe();};
}
window.addEventListener('khaemenes-family-changed',render);
window.addEventListener('khaemenes-learner-context-ready',render);
bind(); render();
})();
</script>
