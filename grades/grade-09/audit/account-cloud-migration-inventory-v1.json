    },
    {
      "id": "pe9",
      "label": "Physical Education 9",
      "sources": [
        "courses/physical-education/index.html",
        "courses/physical-education/assessment-engine.js"
      ],
      "keys": [
        "khae.pe.v1.grade9",
        "khae-pe-g9-w*-days-v1",
        "khae-pe-assessment-v1-*"
      ],
      "ownership": "ambiguous-grade-wide-keys",
      "retain": [
        "36-week practice progress",
        "daily evidence",
        "reflection",
        "randomized question snapshot",
        "answer snapshot",
        "midterm/final drafts",
        "review status"
      ],
      "risk": "grade-wide key has no learner ID; ownership needs explicit proof before cloud binding"
    },
    {
      "id": "elective-language",
      "label": "Foreign Language elective handoff",
      "sources": [
        "grades/grade-09/index.html",
        "courses/electives/world-languages-linguistics/index.html"
      ],
      "keys": [],
      "ownership": "external-repository-not-yet-audited",
      "retain": [
        "course enrollment",
        "lesson attempts",
        "voice/language selections",
        "unit test records"
      ],
      "risk": "language-specific record producers live beyond this High repository; do not declare them migrated"
    },
    {
      "id": "elective-other",
      "label": "Health, arts, music, computing and optional electives",
      "sources": [
        "grades/grade-09/index.html"
      ],
      "keys": [],
      "ownership": "external-or-unmapped-producers",
      "retain": [
        "lesson progress",
        "projects",
        "assessment attempts",
        "portfolio work"
      ],
      "risk": "landing-page links alone do not identify all writable course storage"
    }
  ],
  "migrationContract": {
    "capture": {
      "fields": [
        "source_origin",
        "source_path",
        "source_key",
        "source_key_raw",
        "value_bytes_unchanged",
        "value_sha256",
        "captured_at",
        "schema_detected",
        "learner_id_if_verified",
        "ownership_status",
        "course_id",
        "record_type",
        "format_version"
      ],
      "rules": [
        "enumerate-all-known-and-discovered-keys",
        "do-not-parse-and-reserialize-as-only-copy",
        "include-non-json-text-drafts",
        "capture-before-any-import",
        "backup-download-and-independent-restore-check"
      ]
    },
    "upload": {
      "requires": [
        "authenticated_account",
        "verified_learner_family_relationship",
        "course_authority_classification",
        "idempotency_key",
        "server_side_record_receipt"
      ],
      "mode": "disabled-pending-STOS-T03-commissioning"
    },
    "restore": {
      "requires": [
        "same-learner-match",
        "integrity-hash-match",
        "receipt-match",
        "no-destructive-overwrite",
        "conflict-preserving-merge"
      ],
      "conflict": "quarantine-both-versions"
    },
    "cutover": {
      "requires": [
        "restore-on-second-device-passed",
        "multi-learner-isolation-passed",
        "all-grade9-course-producers-audited",
        "official-authority-receipts-validated",
        "explicit-operator-approval"
      ],
      "mode": "blocked"
    }
  }
}
