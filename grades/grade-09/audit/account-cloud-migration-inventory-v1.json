{
  "schema": "khaemenes-grade09-account-cloud-inventory-v1",
  "version": 1,
  "scope": "grade-09",
  "classification": "source-contract-only-no-learner-records",
  "migrationState": "not-active",
  "created": "2026-11-09",
  "invariants": [
    "copy-before-cutover",
    "never-delete-original-on-import",
    "never-attribute-legacy-record-without-proof",
    "course-produced-assessment-evidence-remains-provisional-until-authority-verified",
    "preserve-original-raw-value-and-source-key",
    "preserve-complete-attempt-history-and-drafts",
    "idempotent-replay-with-content-hash-and-receipt",
    "per-learner-and-per-family-isolation",
    "no-secret-or-personal-records-in-git"
  ],
  "ownershipStates": [
    "learner-scoped",
    "verified-legacy-owner",
    "ambiguous-unclaimed",
    "shared-device",
    "non-academic-ui"
  ],
  "groups": [
    {
      "id": "profile",
      "label": "Grade 9 student profile and course connections",
      "sources": [
        "grades/grade-09/student-profile/index.html",
        "grades/grade-09/student-profile/student-course-registry.js"
      ],
      "keys": [
        "khaemenes-high-profile-v1",
