    },
    {
      "id": "science9",
      "label": "Integrated Science 9",
      "sources": [
        "courses/science/integrated-science-9/index.html",
        "courses/shared/high-school-science-continuation.js",
        "courses/shared/learner-scope-v1.js"
      ],
      "keys": [
        "khae-grade09-integrated-science-portal-v1",
        "khaemenes_science9_*",
        "khae_science9_*",
